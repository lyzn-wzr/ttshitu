{
  "name": "ttshitu",
  "version": "0.1.0",
  "description": "TypeScript client for the TTShitu captcha recognition API.",
  "keywords": [
    "browser",
    "captcha",
    "kuaishibie",
    "node",
    "ocr",
    "ttshitu",
    "typescript",
    "zhunkuai",
    "准快",
    "图鉴",
    "快识别"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src tests --tsconfig tsconfig.json --jsdoc-plugin --vitest-plugin --deny-warnings",
    "lint:fix": "oxlint src tests --tsconfig tsconfig.json --jsdoc-plugin --vitest-plugin --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.1"
}
