{
  "name": "@lyzn/zk-captcha",
  "version": "1.0.0",
  "description": "用于准快/快识别/图鉴的识别验证码SDK。",
  "keywords": [
    "bun",
    "captcha",
    "kuaishibie",
    "node",
    "ocr",
    "ttshitu",
    "typescript",
    "zhunkuai",
    "准快",
    "图鉴",
    "快识别"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": null,
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "bun": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "node": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    },
    "./node": {
      "browser": null,
      "types": {
        "import": "./dist/node.d.ts",
        "require": "./dist/node.d.cts"
      },
      "bun": {
        "import": "./dist/node.mjs",
        "require": "./dist/node.cjs"
      },
      "node": {
        "import": "./dist/node.mjs",
        "require": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "bun run dev/server.ts",
    "build": "tsup",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src tests dev --tsconfig tsconfig.json --jsdoc-plugin --vitest-plugin --deny-warnings",
    "lint:fix": "oxlint src tests dev --tsconfig tsconfig.json --jsdoc-plugin --vitest-plugin --fix",
    "typecheck": "tsc --noEmit && tsc -p dev/tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.5.1"
}
